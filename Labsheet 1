1. Linear Search — O(n)

#include <iostream>
#include <chrono>
using namespace std;
using namespace chrono;

int linearSearch(int arr[], int n, int target) {
    for (int i = 0; i < n; i++) {
        if (arr[i] == target) {
            return i;
        }
    }
    return -1;
}

int main() {
    int sizes[] = {10000, 50000, 100000};

    for (int n : sizes) {
        int* arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = i;
        }

        int target = n - 1;

        auto start = high_resolution_clock::now();

        int result = linearSearch(arr, n, target);

        auto end = high_resolution_clock::now();

        auto timeMicroseconds =
            duration_cast<microseconds>(end - start).count();

        cout << "n = " << n
             << " | Index = " << result
             << " | Time = " << timeMicroseconds
             << " microseconds" << endl;

        delete[] arr;
    }

    return 0;
}




2. Binary Search — O(log n)



#include <iostream>
#include <chrono>
using namespace std;
using namespace chrono;

int binarySearch(int arr[], int n, int target) {
    int low = 0;
    int high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == target) {
            return mid;
        }

        if (arr[mid] < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    return -1;
}

int main() {
    int sizes[] = {10000, 50000, 100000};

    for (int n : sizes) {
        int* arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = i;
        }

        int target = n - 1;

        auto start = high_resolution_clock::now();

        int result = binarySearch(arr, n, target);

        auto end = high_resolution_clock::now();

        auto timeMicroseconds =
            duration_cast<microseconds>(end - start).count();

        cout << "n = " << n
             << " | Index = " << result
             << " | Time = " << timeMicroseconds
             << " microseconds" << endl;

        delete[] arr;
    }

    return 0;
}



3. Nested Loops — O(n²)


#include <iostream>
#include <chrono>
using namespace std;
using namespace chrono;

int main() {
    int sizes[] = {1000, 5000, 10000};

    for (int n : sizes) {
        long long count = 0;

        auto start = high_resolution_clock::now();

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                count++;
            }
        }

        auto end = high_resolution_clock::now();

        auto timeMicroseconds =
            duration_cast<microseconds>(end - start).count();

        cout << "n = " << n
             << " | Operations = " << count
             << " | Time = " << timeMicroseconds
             << " microseconds" << endl;
    }

    return 0;
}
