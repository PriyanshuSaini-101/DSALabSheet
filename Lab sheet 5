#include <iostream>
#include <stack>
#include <string>
#include <cctype>
using namespace std;

int priority(char op) {
    if (op == '+' || op == '-')
        return 1;
    if (op == '*' || op == '/')
        return 2;
    if (op == '^')
        return 3;

    return 0;
}

// Q1: Infix to Postfix
string infixToPostfix(string exp) {
    stack<char> st;
    string result = "";

    for (int i = 0; i < exp.length(); i++) {
        char ch = exp[i];

        if (isspace(ch)) {
            continue;
        }

        if (isalnum(ch)) {
            result += ch;
        }
        else if (ch == '(') {
            st.push(ch);
        }
        else if (ch == ')') {
            while (!st.empty() && st.top() != '(') {
                result += st.top();
                st.pop();
            }

            if (!st.empty()) {
                st.pop();
            }
        }
        else {
            while (!st.empty() && st.top() != '(' &&
                   (priority(st.top()) > priority(ch) ||
                   (priority(st.top()) == priority(ch) && ch != '^'))) {
                result += st.top();
                st.pop();
            }

            st.push(ch);
        }
    }

    while (!st.empty()) {
        result += st.top();
        st.pop();
    }

    return result;
}

// Q2: Postfix Evaluation
int evaluatePostfix(string exp) {
    stack<int> st;

    for (int i = 0; i < exp.length(); i++) {
        char ch = exp[i];

        if (isspace(ch)) {
            continue;
        }

        if (isdigit(ch)) {
            st.push(ch - '0');
        }
        else {
            if (st.size() < 2) {
                cout << "Invalid postfix expression!" << endl;
                return 0;
            }

            int b = st.top();
            st.pop();

            int a = st.top();
            st.pop();

            switch (ch) {
                case '+':
                    st.push(a + b);
                    break;

                case '-':
                    st.push(a - b);
                    break;

                case '*':
                    st.push(a * b);
                    break;

                case '/':
                    if (b == 0) {
                        cout << "Division by zero!" << endl;
                        return 0;
                    }
                    st.push(a / b);
                    break;

                case '^': {
                    int result = 1;
                    for (int j = 0; j < b; j++) {
                        result *= a;
                    }
                    st.push(result);
                    break;
                }

                default:
                    cout << "Invalid operator!" << endl;
                    return 0;
            }
        }
    }

    if (st.size() != 1) {
        cout << "Invalid postfix expression!" << endl;
        return 0;
    }

    return st.top();
}

int main() {
    while (true) {
        cout << "\n===== EXPRESSION CONVERSION & EVALUATION =====" << endl;
        cout << "1. Infix to Postfix" << endl;
        cout << "2. Postfix Evaluation" << endl;
        cout << "3. Exit" << endl;

        int choice;
        cout << "Enter choice: ";
        cin >> choice;
        cin.ignore(10000, '\n');

        if (choice == 1) {
            string infix;

            cout << "Enter Infix Expression: ";
            getline(cin, infix);

            cout << "Postfix Expression: "
                 << infixToPostfix(infix) << endl;
        }
        else if (choice == 2) {
            string postfix;

            cout << "Enter Postfix Expression: ";
            getline(cin, postfix);

            cout << "Final Result: "
                 << evaluatePostfix(postfix) << endl;
        }
        else if (choice == 3) {
            cout << "Program ended." << endl;
            break;
        }
        else {
            cout << "Invalid choice" << endl;
        }
    }

    return 0;
}
