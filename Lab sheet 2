
#include <iostream>
using namespace std;

int main() {
    int arr[100];
    int n, value, index;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter value to insert: ";
    cin >> value;

    cout << "Enter index: ";
    cin >> index;

    if (index >= 0 && index <= n && n < 100) {
        for (int i = n; i > index; i--) {
            arr[i] = arr[i - 1];
        }

        arr[index] = value;
        n++;

        cout << "Array after insertion:" << endl;

        for (int i = 0; i < n; i++) {
            cout << arr[i] << " ";
        }
    } else {
        cout << "Invalid index!";
    }

    return 0;
}
