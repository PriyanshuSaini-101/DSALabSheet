#include <iostream>
#include <queue>
using namespace std;

int main() {

    int n;

    cout << "Enter number of files: ";
    cin >> n;

    priority_queue<int, vector<int>, greater<int>> pq;

    for (int i = 0; i < n; i++) {
        int size;

        cout << "Enter size of file " << i + 1 << ": ";
        cin >> size;

        pq.push(size);
    }

    int totalCost = 0;

    cout << "\nOptimal Merge Sequence:\n";

    while (pq.size() > 1) {

        int file1 = pq.top();
        pq.pop();

        int file2 = pq.top();
        pq.pop();

        int mergeCost = file1 + file2;

        cout << file1 << " + " << file2
             << " = " << mergeCost << endl;

        totalCost += mergeCost;

        pq.push(mergeCost);
    }

    cout << "\nMinimum Total Merge Cost = "
         << totalCost << endl;

    return 0;
}
